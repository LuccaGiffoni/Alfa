---
import About from '../components/About.astro';
import Approach from '../components/Approach.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Office from '../components/Office.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import SinceBand from '../components/SinceBand.astro';
import Trust from '../components/Trust.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="ALFA Contabilidade — Contabilidade em Jacareí desde 1981"
  description="Contabilidade próxima em Jacareí desde 1981: contábil, fiscal e tributário, trabalhista, societário e orientação com atendimento pessoal."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <SinceBand />
    <About />
    <Services />
    <Approach />
    <Process />
    <Trust />
    <Office />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
