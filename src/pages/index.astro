---
import About from '../components/About.astro';
import Approach from '../components/Approach.astro';
import Cta from '../components/Cta.astro';
import Diagnostic from '../components/Diagnostic.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Moment from '../components/Moment.astro';
import Office from '../components/Office.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import Stats from '../components/Stats.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Contabilidade em Jacareí | Alfa Contabilidade desde 1981"
  description="Abra sua empresa, troque de contador ou organize sua contabilidade com a Alfa, em Jacareí. Desde 1981: contábil, fiscal, trabalhista e societário. Fale pelo WhatsApp."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Moment />
    <About />
    <Stats />
    <Services />
    <Diagnostic />
    <Approach />
    <Process />
    <Office />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
