---
import SectionLabel from './SectionLabel.astro';
import { site } from '../data/site';

const faqs = [
  {
    question: 'Como começa o atendimento?',
    answer:
      'Começa com uma conversa para entender a empresa, a rotina atual e o que precisa de mais atenção. A partir daí, alinhamos o caminho de atendimento.',
  },
  {
    question: 'Posso conversar presencialmente?',
    answer: `Sim. Nosso escritório fica na ${site.address.street}, em ${site.address.city}. Combine um horário pelo WhatsApp ou por e-mail e venha conversar com calma.`,
  },
  {
    question: 'A ALFA atende empresas que já têm contador?',
    answer:
      'Sim. Na primeira conversa entendemos como a rotina funciona hoje e, se fizer sentido seguir com a ALFA, alinhamos juntos como fica a transição.',
  },
  {
    question: 'Quais serviços contábeis estão disponíveis?',
    answer:
      'Contabilidade, fiscal e tributário, trabalhista, societário, obrigações acessórias e orientação próxima para as decisões do dia a dia.',
  },
  {
    question: 'Como envio documentos e tiro dúvidas?',
    answer: `O fluxo de documentos é combinado no plano de atendimento. Para dúvidas, chame no WhatsApp ${site.phone.display} ou escreva para ${site.email}.`,
  },
];
---

<section class="faq" id="duvidas" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__intro">
      <SectionLabel number="07">Dúvidas frequentes</SectionLabel>
      <h2 class="display" id="faq-title">PERGUNTAR FAZ PARTE.</h2>
      <p>Reunimos respostas iniciais. Se a sua dúvida for diferente, a conversa continua diretamente com a ALFA.</p>
      <span class="faq__mark" aria-hidden="true"></span>
    </div>

    <div class="faq__list">
      {faqs.map((faq, index) => (
        <details class="faq__item" name="faq" open={index === 0}>
          <summary>
            <span>{faq.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--paper-2);
    padding-block: var(--section-y);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 430fr) minmax(0, 786fr);
    gap: 80px;
    align-items: start;
  }

  .faq__intro {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .faq__intro p {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .faq__mark {
    position: relative;
    width: 208px;
    height: 18px;
  }

  .faq__mark::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--red);
  }

  .faq__mark::after {
    content: '';
    position: absolute;
    left: 28px;
    top: 8px;
    width: 180px;
    height: 2px;
    background: var(--ink);
  }

  .faq__list {
    border-top: 2px solid var(--ink);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 28px;
    padding: 22px 0;
    font-size: clamp(18px, calc(0.5vw + 14px), 21px);
    font-weight: 800;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--red);
  }

  .faq__item[open] summary {
    padding-bottom: 14px;
  }

  .faq__item p {
    padding: 0 56px 22px 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  /* "+" fechado, "−" aberto (em vermelho), como no layout. */
  .faq__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    color: var(--ink);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 13px;
    width: 14px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s;
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    color: var(--red);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  @media (max-width: 960px) {
    .faq__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .faq__intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .faq__item p {
      padding-right: 0;
    }
  }
</style>
