---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photos } from '../data/photos';
import { site, wa, yearsActive } from '../data/site';

const routine = ['Impostos apurados', 'Folha processada', 'Obrigações entregues'];
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="blob b1"></span><span class="blob b2"></span>
    <div class="grid-lines"></div>
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow reveal"><span class="pulse-dot"></span>Contabilidade em {site.address.city} · desde {site.foundingYear}</span>
      <h1 class="reveal" style="--d:.08s">
        Sua empresa merece <em class="serif accent">clareza.</em><br />
        E um contador <span class="underline">por perto</span>.
      </h1>
      <p class="lead reveal" style="--d:.16s">
        Abrir, organizar e acompanhar sua empresa — do fiscal à folha de pagamento — com quem entende o seu negócio e atende pelo nome.
      </p>
      <div class="hero-actions reveal" style="--d:.24s">
        <a class="btn btn-primary btn-lg magnetic" {...wa()}><Icon name="wa" /> Falar com um contador</a>
        <a class="btn btn-ghost btn-lg" href="#diagnostico">Diagnóstico em 30s <Icon name="arrow" /></a>
      </div>
      <ul class="hero-trust reveal" style="--d:.32s">
        <li><Icon name="check" />{yearsActive} anos de experiência</li>
        <li><Icon name="check" />Atendimento pessoal</li>
        <li><Icon name="check" />Escritório em {site.address.city}</li>
      </ul>
    </div>

    <div class="hero-visual reveal" style="--d:.2s" data-tilt>
      <div class="hero-photo">
        <Image src={photos.hero.src} alt={photos.hero.alt} widths={[480, 768, 1040]} sizes="(max-width: 600px) 100vw, 520px" quality={85} loading="eager" fetchpriority="high" />
      </div>

      <div class="float-card card-years" data-depth="30">
        <span class="big"><span data-count={yearsActive}>{yearsActive}</span><sup>anos</sup></span>
        <span class="muted">cuidando de empresas<br />em {site.address.city}</span>
      </div>

      <div class="float-card card-routine" data-depth="18" aria-hidden="true">
        <span class="card-title">Rotina do mês</span>
        <ul class="routine">
          {routine.map((task) => <li><span class="tick"><svg><use href="#i-check" /></svg></span>{task}</li>)}
        </ul>
        <div class="routine-bar"><span></span></div>
      </div>

      <div class="float-card card-chat" data-depth="44" aria-hidden="true">
        <span class="avatar"><svg><use href="#logo-a" /></svg></span>
        <span class="chat-body">
          <strong>Alfa Contabilidade</strong>
          <span class="chat-msg">Oi! Como podemos ajudar sua empresa hoje? <span class="typing"><i></i><i></i><i></i></span></span>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Foto com leve inclinação e cartões em parallax, seguindo o ponteiro
  const tilt = document.querySelector<HTMLElement>('[data-tilt]')!;
  const hero = tilt.closest<HTMLElement>('.hero')!;
  if (finePointer && !reduceMotion) {
    const photo = tilt.querySelector<HTMLElement>('.hero-photo')!;
    const layers = tilt.querySelectorAll<HTMLElement>('[data-depth]');
    hero.addEventListener('pointermove', (event) => {
      const r = tilt.getBoundingClientRect();
      const x = (event.clientX - (r.left + r.width / 2)) / r.width;
      const y = (event.clientY - (r.top + r.height / 2)) / r.height;
      photo.style.setProperty('--ry', `${x * 6}deg`);
      photo.style.setProperty('--rx', `${-y * 6}deg`);
      layers.forEach((layer) => {
        const depth = Number(layer.dataset.depth);
        layer.style.setProperty('--tx', `${-x * depth}px`);
        layer.style.setProperty('--ty', `${-y * depth}px`);
      });
    });
    hero.addEventListener('pointerleave', () => {
      photo.style.setProperty('--ry', '0deg');
      photo.style.setProperty('--rx', '0deg');
      layers.forEach((layer) => {
        layer.style.setProperty('--tx', '0px');
        layer.style.setProperty('--ty', '0px');
      });
    });

    // Botão principal "magnético"
    hero.querySelectorAll<HTMLElement>('.magnetic').forEach((btn) => {
      btn.addEventListener('pointermove', (event) => {
        const r = btn.getBoundingClientRect();
        const x = event.clientX - r.left - r.width / 2;
        const y = event.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${x * 0.18}px, ${y * 0.3 - 2}px)`;
      });
      btn.addEventListener('pointerleave', () => (btn.style.transform = ''));
    });
  }

  // Cartão "Rotina do mês": marca as tarefas uma a uma, em loop
  const tasks = hero.querySelectorAll('.routine li');
  const routineBar = hero.querySelector<HTMLElement>('.routine-bar span')!;
  let step = 0;
  const run = () => {
    tasks.forEach((li, i) => li.classList.toggle('done', i < step));
    routineBar.style.width = `${(step / tasks.length) * 100}%`;
    step = step >= tasks.length ? 0 : step + 1;
  };
  if (reduceMotion) {
    step = tasks.length;
    run();
  } else {
    setTimeout(() => {
      run();
      setInterval(run, 1300);
    }, 900);
  }
</script>

<style>
  .hero { position: relative; padding: calc(var(--header-h) + clamp(40px, 7vw, 90px)) 0 clamp(50px, 7vw, 90px); background: var(--cream); overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .55; }
  .b1 { width: 520px; height: 520px; background: #c9cff3; top: -160px; right: -80px; animation: float 16s ease-in-out infinite; }
  .b2 { width: 380px; height: 380px; background: #f3d3cf; bottom: 40px; left: -140px; animation: float 20s ease-in-out infinite reverse; }
  .grid-lines {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(31, 42, 114, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(31, 42, 114, .06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
  }
  @keyframes float { 50% { transform: translate(30px, 40px) scale(1.08); } }

  .hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 16px 8px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--line);
    font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--navy);
    box-shadow: var(--shadow-sm);
  }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); position: relative; }
  .pulse-dot::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--red); animation: ping 2s var(--ease) infinite; }
  @keyframes ping { 0% { transform: scale(.6); opacity: 1; } 100% { transform: scale(2.2); opacity: 0; } }

  h1 { position: relative; z-index: 0; font-size: clamp(2.7rem, 6.4vw, 5.2rem); line-height: 1.02; letter-spacing: -.04em; margin: 26px 0 24px; font-weight: 800; }
  h1 .serif { font-size: 1.1em; letter-spacing: -.02em; }
  .underline { position: relative; white-space: nowrap; }
  .underline::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: .04em; height: .14em; border-radius: 4px;
    background: linear-gradient(90deg, var(--navy), #4c5bc4); transform: scaleX(0); transform-origin: left;
    transition: transform 1.1s var(--ease) .9s; z-index: -1; opacity: .9;
  }
  .reveal.in .underline::after { transform: scaleX(1); }
  .lead { font-size: clamp(1.05rem, 1.5vw, 1.2rem); max-width: 520px; color: var(--text); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 34px 0 30px; }
  .hero-trust { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: .92rem; font-weight: 600; color: var(--ink); }
  .hero-trust li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-trust .ico { color: #fff; background: var(--navy); border-radius: 50%; padding: 3px; width: 20px; height: 20px; }

  .hero-visual { position: relative; perspective: 1200px; padding: 20px 0 60px; }
  .hero-photo {
    position: relative; border-radius: 32px; overflow: hidden; aspect-ratio: 4 / 4.6;
    box-shadow: var(--shadow-lg); transform: rotateY(var(--ry, 0deg)) rotateX(var(--rx, 0deg));
    transition: transform .6s var(--ease); margin-left: auto; max-width: 520px;
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); }
  .hero-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(15, 21, 64, .45)); }

  .float-card {
    position: absolute; background: rgba(255, 255, 255, .92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, .7); border-radius: 18px; box-shadow: var(--shadow); padding: 16px 18px;
    transform: translate(var(--tx, 0), var(--ty, 0)); transition: transform .5s var(--ease);
  }
  .card-years { left: -18px; top: 65%; display: flex; align-items: center; gap: 14px; animation: bob 6s ease-in-out infinite; }
  .card-years .big { font-size: 2.6rem; font-weight: 800; color: var(--navy); line-height: 1; letter-spacing: -.04em; }
  .card-years sup { font-size: .8rem; letter-spacing: 0; color: var(--red); margin-left: 3px; top: -1.3em; }
  .card-years .muted { font-size: .78rem; line-height: 1.35; color: var(--muted); font-weight: 600; }

  .card-routine { right: -14px; bottom: 22%; width: 230px; animation: bob 7s ease-in-out -2s infinite; }
  .card-title { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .routine { list-style: none; margin: 10px 0 12px; padding: 0; display: grid; gap: 8px; }
  .routine li { display: flex; align-items: center; gap: 10px; font-size: .88rem; font-weight: 600; color: var(--ink); opacity: .35; transition: opacity .4s; }
  .routine li.done { opacity: 1; }
  .tick { width: 22px; height: 22px; border-radius: 7px; border: 2px solid var(--line); display: grid; place-items: center; transition: background .35s, border-color .35s; }
  .tick svg { width: 14px; height: 14px; color: #fff; transform: scale(0); transition: transform .35s var(--ease); }
  .routine li.done .tick { background: var(--navy); border-color: var(--navy); }
  .routine li.done .tick svg { transform: scale(1); }
  .routine-bar { height: 6px; border-radius: 6px; background: var(--navy-50); overflow: hidden; }
  .routine-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--navy), var(--red)); border-radius: inherit; transition: width .6s var(--ease); }

  .card-chat { left: 6%; bottom: 0; display: flex; gap: 12px; align-items: center; max-width: 320px; animation: bob 8s ease-in-out -4s infinite; }
  .avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--navy); display: grid; place-items: center; flex: none; position: relative; }
  .avatar svg { width: 18px; height: 26px; color: #fff; --logo-dot: var(--rose); }
  .avatar::after { content: ""; position: absolute; right: 0; bottom: 1px; width: 11px; height: 11px; border-radius: 50%; background: var(--wa); border: 2px solid #fff; }
  .chat-body { display: flex; flex-direction: column; font-size: .86rem; line-height: 1.4; }
  .chat-body strong { color: var(--ink); font-size: .8rem; }
  .chat-msg { color: var(--text); }
  .typing { display: inline-flex; gap: 3px; margin-left: 4px; vertical-align: middle; }
  .typing i { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); animation: typing 1.2s infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; }
  .typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes typing { 0%, 60%, 100% { transform: none; opacity: .4; } 30% { transform: translateY(-4px); opacity: 1; } }
  @keyframes bob { 50% { translate: 0 -10px; } }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 520px; margin: 0 auto; width: 100%; }
  }

  @media (max-width: 600px) {
    h1 { font-size: clamp(2.35rem, 11vw, 3rem); }
    .eyebrow { font-size: .66rem; letter-spacing: .06em; padding: 7px 12px 7px 10px; }
    .underline { white-space: normal; }
    .hero-actions .btn { width: 100%; }
    .card-years { left: auto; right: -4px; top: 4px; padding: 12px 14px; }
    .card-years .big { font-size: 2rem; }
    .card-routine { right: -4px; width: 190px; bottom: 26%; padding: 12px 14px; }
    .routine li { font-size: .8rem; }
    .card-chat { left: 0; right: 16px; max-width: none; }
  }
</style>
