---
import Icon from './Icon.astro';
import { site } from '../data/site';

const distant = [
  'Atendimento por ticket ou robô',
  'A cada contato, uma pessoa diferente',
  'Relatórios cheios de jargão',
  'Só aparece quando o prazo aperta',
  'Sem lugar para sentar e conversar',
];
const alfa = [
  'Conversa direta pelo WhatsApp ou presencial',
  'Quem atende conhece a sua empresa',
  'Explicações claras, sem complicar',
  'Atenção à rotina, não só aos prazos',
  `Escritório em ${site.address.city}, desde ${site.foundingYear}`,
];
---

<section class="section way" id="nosso-jeito">
  <div class="container">
    <div class="section-head split reveal">
      <div>
        <span class="kicker">03 · Nosso jeito</span>
        <h2 class="section-title">A tecnologia ajuda. <em class="serif">A presença orienta.</em></h2>
      </div>
      <p>Usamos ferramentas para organizar o trabalho, mas não substituímos conversa por distância. Quando surge uma dúvida, você encontra escuta, contexto e uma explicação que faz sentido.</p>
    </div>

    <div class="compare reveal">
      <div class="compare-col other">
        <span class="compare-tag">Contabilidade distante</span>
        <ul>
          {distant.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="compare-col alfa">
        <span class="compare-tag"><svg class="mini-logo" aria-hidden="true"><use href="#logo-a" /></svg> Com a Alfa</span>
        <ul>
          {alfa.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
      </div>
    </div>

    <figure class="big-quote reveal">
      <blockquote>Perto o bastante para entender <em class="serif">o que não cabe em um formulário.</em></blockquote>
      <figcaption>ALFA / {site.foundingYear} — hoje</figcaption>
    </figure>
  </div>
</section>

<style>
  .way { background: var(--cream); }
  .compare { display: grid; grid-template-columns: 1fr 1.15fr; gap: 18px; align-items: stretch; }
  .compare-col { border-radius: var(--radius); padding: clamp(26px, 4vw, 40px); }
  .compare-col ul { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 14px; }
  .compare-col li { display: flex; align-items: flex-start; gap: 12px; font-weight: 550; }
  .compare-tag { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; }
  .compare-col.other { background: transparent; border: 1.5px dashed #cfccc0; color: var(--muted); }
  .compare-col.other li::before { content: "✕"; flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .7rem; background: #e7e4da; color: #9b988c; margin-top: 2px; }
  .compare-col.other li { text-decoration: line-through; text-decoration-color: rgba(116, 119, 138, .4); }
  .compare-col.alfa { background: var(--navy); color: #fff; box-shadow: var(--shadow-lg); transform: translateY(-10px); }
  .compare-col.alfa .compare-tag { color: var(--rose); }
  .compare-col.alfa li { font-size: 1.05rem; }
  .compare-col.alfa li .ico { color: var(--navy); background: #fff; border-radius: 50%; padding: 4px; width: 24px; height: 24px; margin-top: 1px; }
  .mini-logo { width: 14px; height: 20px; color: #fff; --logo-dot: var(--rose); }

  .big-quote { margin: clamp(60px, 8vw, 100px) 0 0; text-align: center; }
  .big-quote blockquote { margin: 0 auto; max-width: 900px; font-size: clamp(1.9rem, 4.4vw, 3.4rem); font-weight: 700; color: var(--ink); letter-spacing: -.035em; line-height: 1.12; }
  .big-quote blockquote .serif { color: var(--red); }
  .big-quote figcaption { margin-top: 20px; font-size: .8rem; letter-spacing: .3em; color: var(--muted); font-weight: 700; }

  @media (max-width: 900px) {
    .compare { grid-template-columns: 1fr; }
    .compare-col.alfa { transform: none; }
  }
</style>
