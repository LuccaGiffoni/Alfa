---
import { site } from '../data/site';
const paths = [
  { title: 'Quero abrir uma empresa', text: 'Entenda os próximos passos para tirar seu negócio do papel, com apoio na abertura e na organização inicial.', message: 'Olá! Quero abrir uma empresa e gostaria de orientação da Alfa.' },
  { title: 'Quero trocar de contador', text: 'Converse sobre sua rotina atual e conheça como podemos acompanhar a transição para a Alfa.', message: 'Olá! Estou pensando em trocar de contador e quero conhecer a Alfa.' },
  { title: 'Preciso organizar minha rotina', text: 'Conte suas dúvidas sobre contabilidade, impostos ou folha. Vamos entender o que sua empresa precisa.', message: 'Olá! Preciso de apoio para organizar a rotina contábil da minha empresa.' },
];
---
<section class="start" aria-labelledby="start-title">
  <div class="container">
    <div class="start__heading"><p>SEU PRÓXIMO PASSO</p><h2 id="start-title">Em que momento está sua empresa?</h2></div>
    <ul class="start__grid">
      {paths.map((path, index) => <li><a href={`https://wa.me/${site.phone.e164.replace('+', '')}?text=${encodeURIComponent(path.message)}`} target="_blank" rel="noopener"><span class="start__number">0{index + 1} <span aria-hidden="true">↗</span></span><h3>{path.title}</h3><p>{path.text}</p><span class="start__action">Conversar com a Alfa</span></a></li>)}
    </ul>
  </div>
</section>
<style>
  .start { padding-block: 64px; background: var(--paper-2); }
  .start__heading { margin-bottom: 32px; }
  .start__heading > p { color: var(--red); font-size: 11px; letter-spacing: .12em; font-weight: 800; margin-bottom: 12px; }
  h2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.15; letter-spacing: -.04em; }
  .start__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  li a { display: flex; flex-direction: column; height: 100%; padding: 28px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; transition: border-color .2s, background .2s; }
  li a:hover { border-color: var(--red); background: var(--paper); }
  .start__number { display: flex; justify-content: space-between; color: var(--red); font-weight: 700; font-size: 13px; margin-bottom: 26px; }
  h3 { font-size: 23px; line-height: 1.2; letter-spacing: -.03em; margin-bottom: 14px; }
  li p { color: var(--muted); font-size: 15px; line-height: 1.6; margin-bottom: 28px; }
  .start__action { margin-top: auto; font-size: 13px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  @media(max-width: 760px) { .start__grid { grid-template-columns: 1fr; } }
</style>
