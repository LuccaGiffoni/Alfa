---
import LogoMark from '../assets/brand/logo-alfa.svg';
import LogoMarkWhite from '../assets/brand/logo-alfa-white.svg';
import { asset } from '../data/site';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<a href={asset('')} class:list={['logo', `logo--${tone}`]} aria-label="ALFA Contabilidade — início">
  {
    tone === 'light' ? (
      <LogoMarkWhite width={36} height={52} aria-hidden="true" />
    ) : (
      <LogoMark width={36} height={52} aria-hidden="true" />
    )
  }
  <span class="logo__words" aria-hidden="true">
    <span class="logo__name">ALFA</span>
    <span class="logo__tag">Contabilidade</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo--dark {
    color: var(--ink);
  }

  .logo--light {
    color: var(--white);
  }

  .logo :global(svg) {
    flex: none;
  }

  .logo__words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo__name {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: 0.01em;
  }

  .logo__tag {
    margin-top: 4px;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
