---
import { asset } from '../data/site';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<a href={asset('')} class:list={['logo', `logo--${tone}`]} aria-label="ALFA Contabilidade — início">
  <svg width="36" height="52" viewBox="0 0 36 52" aria-hidden="true">
    <rect x="1" y="1" width="32" height="50" fill="none" stroke="currentColor" stroke-width="2"></rect>
    <circle class="logo__dot" cx="24.5" cy="36.5" r="3.5"></circle>
  </svg>
  <span class="logo__words" aria-hidden="true">
    <span class="logo__name">ALFA</span>
    <span class="logo__tag">Contabilidade</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo--dark {
    color: var(--ink);
  }

  .logo--dark .logo__dot {
    fill: var(--red);
  }

  .logo--light {
    color: var(--white);
  }

  .logo--light .logo__dot {
    fill: var(--terracotta);
  }

  .logo__words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo__name {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: 0.01em;
  }

  .logo__tag {
    margin-top: 4px;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
