---
interface Props {
  size?: number;
  class?: string;
}
const { size = 17, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="square"
  aria-hidden="true"
>
  <path d="M7 17 17 7M9 7h8v8"></path>
</svg>
