---
import Brand from './Brand.astro';
import { asset, site, wa } from '../data/site';
import { servicePages } from '../data/services';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === asset('');

const sections = [
  { label: 'A empresa', href: '#a-alfa' },
  { label: 'Nosso jeito', href: '#nosso-jeito' },
  { label: 'Como atendemos', href: '#como-atendemos' },
  { label: 'Escritório', href: '#escritorio' },
  { label: 'Perguntas frequentes', href: '#duvidas' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Brand href={isHome ? '#topo' : asset('')} tone="light" />
      <p>Contabilidade feita por pessoas, para empresas conduzidas por pessoas. Em {site.address.city}, desde {site.foundingYear}.</p>
    </div>
    <nav aria-label="Navegação">
      <h4>Navegação</h4>
      {sections.map((link) => <a href={asset(link.href)}>{link.label}</a>)}
    </nav>
    <nav aria-label="Serviços">
      <h4>Serviços</h4>
      {servicePages.map((service) => <a href={asset(`servicos/${service.slug}/`)}>{service.name}</a>)}
    </nav>
    <div>
      <h4>Contato</h4>
      <a {...wa()}>{site.phone.display}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.mapsUrl} target="_blank" rel="noopener">{site.address.street}<br />{site.address.city} — {site.address.state}</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Alfa Contabilidade. Todos os direitos reservados.</span>
    <a href="#topo" class="to-top">Voltar ao topo ↑</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-900); color: rgba(255, 255, 255, .65); padding: 80px 0 30px; font-size: .95rem; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.1fr; gap: 40px; padding-bottom: 50px; border-bottom: 1px solid rgba(255, 255, 255, .1); }
  .footer-brand p { margin-top: 18px; max-width: 300px; }
  h4 { color: #fff; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 18px; }
  .footer-grid > :not(.footer-brand) { display: flex; flex-direction: column; gap: 10px; }
  .footer-grid a { transition: color .2s; word-break: break-word; }
  .footer-grid a:hover { color: #fff; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 26px 90px 0 0; font-size: .85rem; }
  .to-top:hover { color: #fff; }

  @media (max-width: 1080px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
