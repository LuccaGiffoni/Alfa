---
import Button from './Button.astro';
import SectionLabel from './SectionLabel.astro';
import { site } from '../data/site';
---

<section class="trust" aria-labelledby="trust-title">
  <div class="container trust__inner">
    <span class="trust__slab" aria-hidden="true"></span>
    <span class="trust__dot" aria-hidden="true"></span>

    <div class="trust__content">
      <SectionLabel number="05" tone="dark">Confiança e tradição</SectionLabel>
      <h2 class="display" id="trust-title" style="--max-size: 68px">A CONFIANÇA VEM DA CONSTÂNCIA.</h2>
      <div class="trust__since">
        <span class="trust__year">{site.foundingYear}</span>
        <p>
          Tempo de atuação que se traduz em responsabilidade, memória de relacionamento e compromisso com um atendimento
          cuidadoso.
        </p>
      </div>
      <Button href={site.whatsappUrl} variant="light" external>Iniciar uma conversa</Button>
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--ink);
    color: var(--white);
    overflow: hidden;
  }

  .trust__inner {
    position: relative;
    min-height: 560px;
    padding-block: 72px;
  }

  .trust__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    max-width: 800px;
  }

  .trust__since {
    display: flex;
    align-items: flex-end;
    gap: 38px;
  }

  .trust__year {
    flex: none;
    color: var(--red);
    font-size: 48px;
    font-weight: 900;
    line-height: 1;
  }

  .trust__since p {
    max-width: 520px;
    color: var(--line);
    font-size: 17px;
    line-height: 1.55;
  }

  .trust__slab {
    position: absolute;
    top: -100px;
    right: var(--gutter);
    width: min(340px, 22vw);
    height: 580px;
    background: var(--ink-2);
  }

  .trust__dot {
    position: absolute;
    z-index: 1;
    right: calc(var(--gutter) + 110px);
    bottom: 98px;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--red);
  }

  @media (max-width: 1100px) {
    .trust__slab,
    .trust__dot {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .trust__inner {
      min-height: 0;
      padding-block: var(--section-y);
    }

    .trust__since {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
