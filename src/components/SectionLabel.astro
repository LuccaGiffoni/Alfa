---
interface Props {
  number?: string;
  tone?: 'light' | 'dark';
  dot?: 'red' | 'navy';
  muted?: boolean;
}
const { number, tone = 'light', dot = 'red', muted = false } = Astro.props;
---

<p class:list={['label', `label--${tone}`, { 'label--muted': muted }]}>
  <span class:list={['label__dot', `label__dot--${dot}`]} aria-hidden="true"></span>
  {number && <span class="label__num">{number}</span>}
  <span class="label__text"><slot /></span>
</p>

<style>
  .label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .label__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .label__dot--red {
    background: var(--red);
  }

  .label__dot--navy {
    background: var(--navy);
  }

  .label--light .label__num {
    color: var(--muted);
  }

  .label--light .label__text {
    color: var(--ink);
  }

  .label--dark .label__num {
    color: var(--line);
  }

  .label--dark .label__text {
    color: var(--white);
  }

  .label--muted .label__text {
    color: var(--muted);
  }
</style>
