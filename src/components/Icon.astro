---
// Ícones do sprite definido em layouts/Base.astro.
interface Props {
  name: 'wa' | 'arrow' | 'check';
  class?: string;
  [attr: `data-${string}`]: unknown;
}
const { name, class: className = 'ico', ...attrs } = Astro.props;
---

<svg class={className} aria-hidden="true" {...attrs}><use href={`#i-${name}`} /></svg>
